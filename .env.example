# Bot-Token: bleibt in Env/Docker-Secret, nie in der Datenbank.
DISCORD_TOKEN=
# Master-Key fuer die AES-Verschluesselung der RCON-Passwoerter. Erzeugen mit:  openssl rand -base64 32
# Sichern! Ohne diesen Key sind alle gespeicherten RCON-Passwoerter unbrauchbar.
RCONMC_MASTER_KEY=
DB_PATH=/data/rconmc.db
# Optional
RCONMC_MAX_SERVERS_PER_GUILD=5
# false = Hosts in privaten/lokalen Netzen ablehnen (empfohlen, wenn fremde Guilds den Bot nutzen)
RCONMC_ALLOW_PRIVATE_HOSTS=true
# Nur fuer Management-Protocol-Server mit TLS und selbst signiertem Zertifikat (Truststore mit dem Serverzertifikat)
RCONMC_MGMT_TRUSTSTORE_PATH=
RCONMC_MGMT_TRUSTSTORE_PASSWORD=
